<Window x:Class="ComicReader.App.Views.PasswordDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="加密压缩包"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource PanelBrush}">
    <StackPanel Margin="22" Width="380">
        <TextBlock Text="该压缩包已加密，请输入密码：" FontSize="14" />
        <TextBlock x:Name="BookNameText"
                   Margin="0,8,0,12"
                   Foreground="{DynamicResource FgMutedBrush}"
                   TextTrimming="CharacterEllipsis" />
        <PasswordBox x:Name="Pwd" FontSize="14" />
        <CheckBox x:Name="RememberCheck" Content="记住密码" IsChecked="True" Margin="0,14,0,0" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="取消" Width="84" Click="OnCancel" Margin="0,0,10,0" />
            <Button Content="确定" Width="84" Click="OnOk" IsDefault="True" />
        </StackPanel>
    </StackPanel>
</Window>
