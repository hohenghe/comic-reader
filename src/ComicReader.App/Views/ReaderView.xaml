<UserControl x:Class="ComicReader.App.Views.ReaderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="True"
             Background="{DynamicResource ReaderBgBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{DynamicResource PanelBrush}"
                BorderBrush="{DynamicResource DividerBrush}"
                BorderThickness="0,0,0,1">
            <Border.Style>
                <Style TargetType="Border">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsUiVisible}" Value="False">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid Margin="10,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Button Content="← 书库" Click="OnBackClick" ToolTip="返回书库 (Esc)" />
                    <TextBlock Text="{Binding Title}" Margin="14,0,0,0" FontWeight="SemiBold"
                               MaxWidth="420" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                </StackPanel>

                <TextBlock Grid.Column="1" Text="{Binding PageLabel}" HorizontalAlignment="Center"
                           Foreground="{DynamicResource FgMutedBrush}" />

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <ComboBox Width="108" Margin="0,0,6,0" ItemsSource="{Binding ModeOptions}"
                              SelectedValue="{Binding Mode}" SelectedValuePath="Value" DisplayMemberPath="Name"
                              ToolTip="阅读模式" />
                    <ComboBox Width="156" Margin="0,0,6,0" ItemsSource="{Binding DirectionOptions}"
                              SelectedValue="{Binding Direction}" SelectedValuePath="Value" DisplayMemberPath="Name"
                              ToolTip="阅读方向" />
                    <ComboBox Width="112" Margin="0,0,6,0" ItemsSource="{Binding FitOptions}"
                              SelectedValue="{Binding Fit}" SelectedValuePath="Value" DisplayMemberPath="Name"
                              ToolTip="缩放适应" />
                    <ToggleButton Content="缩略图" IsChecked="{Binding ShowThumbnails}" Margin="0,0,6,0" ToolTip="缩略图 (T)" />
                    <Button Content="⛶" Width="42" Click="OnFullscreenClick" ToolTip="全屏 (F)" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Grid x:Name="Viewport" Grid.Column="0" ClipToBounds="True" Background="{DynamicResource ReaderBgBrush}"
                  SizeChanged="OnViewportSizeChanged"
                  MouseWheel="OnViewportWheel"
                  MouseLeftButtonDown="OnViewportMouseDown"
                  MouseMove="OnViewportMouseMove"
                  MouseLeftButtonUp="OnViewportMouseUp">
                <Grid x:Name="PageRoot" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                    <Grid.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform x:Name="ZoomScale" />
                            <TranslateTransform x:Name="PanTranslate" />
                        </TransformGroup>
                    </Grid.RenderTransform>
                    <Image x:Name="SingleImage" Stretch="Fill" />
                    <StackPanel x:Name="DoublePanel" Orientation="Horizontal" Visibility="Collapsed">
                        <Image x:Name="LeftImage" Stretch="Fill" Margin="0,0,4,0" />
                        <Image x:Name="RightImage" Stretch="Fill" Margin="4,0,0,0" />
                    </StackPanel>
                </Grid>

                <ProgressBar Height="3" VerticalAlignment="Top" IsIndeterminate="True"
                             Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}" />

                <TextBlock Text="{Binding ErrorText}"
                           Foreground="{DynamicResource DangerBrush}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           TextWrapping="Wrap" MaxWidth="640">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ErrorText}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>

            <ScrollViewer x:Name="ScrollHost" Grid.Column="0" Visibility="Collapsed"
                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          CanContentScroll="False"
                          ScrollChanged="OnScrollChanged" SizeChanged="OnScrollSizeChanged"
                          PreviewMouseLeftButtonDown="OnScrollMouseDown"
                          PreviewMouseLeftButtonUp="OnScrollMouseUp">
                <StackPanel x:Name="ScrollStack" Margin="0,8" />
            </ScrollViewer>

            <Border Grid.Column="1" Width="200"
                    Background="{DynamicResource PanelBrush}"
                    BorderBrush="{DynamicResource DividerBrush}"
                    BorderThickness="1,0,0,0"
                    Visibility="{Binding ShowThumbnails, Converter={StaticResource BoolToVis}}">
                <ListBox x:Name="ThumbList" ItemsSource="{Binding Thumbs}" SelectionChanged="OnThumbSelected">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="4">
                                <TextBlock Text="{Binding Label}" Width="42"
                                           Foreground="{DynamicResource FgMutedBrush}" VerticalAlignment="Center" />
                                <Border Width="116" Height="152" Background="{DynamicResource Panel2Brush}" CornerRadius="4">
                                    <Image Source="{Binding Image}" Stretch="Uniform" />
                                </Border>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>
        </Grid>

        <Border Grid.Row="2"
                Background="{DynamicResource PanelBrush}"
                BorderBrush="{DynamicResource DividerBrush}"
                BorderThickness="0,1,0,0">
            <Border.Style>
                <Style TargetType="Border">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsUiVisible}" Value="False">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid Margin="14,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Slider Grid.Column="0" Minimum="0" Maximum="{Binding MaxIndex}"
                        Value="{Binding CurrentIndex, Mode=TwoWay}"
                        IsSnapToTickEnabled="True" TickFrequency="1" />
                <TextBlock Grid.Column="1" Text="{Binding PageLabel}" Width="100" TextAlignment="Right"
                           Foreground="{DynamicResource FgMutedBrush}" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
